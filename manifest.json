{
  "name": "ARTemis Professional",
  "short_name": "ARTemis",
  "description": "Professional digital painting application with advanced brush engine, vector tools, and AI-powered features",
  "id": "/src/index.html",
  "start_url": "./src/index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#1e1e1e",
  "theme_color": "#0e639c",
  "orientation": "any",
  "icons": [
    {
      "src": "./src/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./src/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": [
    "graphics",
    "productivity",
    "utilities",
    "design"
  ],
  "screenshots": [
    {
      "src": "./screenshots/main-interface.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "label": "Main painting interface",
      "form_factor": "wide"
    },
    {
      "src": "./screenshots/brush-engine.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "label": "Advanced brush engine",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "New Canvas",
      "short_name": "New",
      "description": "Create a new canvas",
      "url": "./src/index.html?action=new",
      "icons": [
        {
          "src": "./src/assets/icon-new.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Open File",
      "short_name": "Open",
      "description": "Open an existing file",
      "url": "./src/index.html?action=open",
      "icons": [
        {
          "src": "./src/assets/icon-open.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./src/index.html",
      "accept": {
        "application/x-artemis": [".artemis"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/svg+xml": [".svg"]
      }
    }
  ],
  "share_target": {
    "action": "./src/index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/svg+xml"]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "features": [
    "Advanced brush engine",
    "Vector path editing",
    "AI-powered tools",
    "Cloud synchronization",
    "Plugin marketplace",
    "Offline support"
  ],
  "prefer_related_applications": false
}
