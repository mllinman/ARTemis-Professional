{
  "name": "artemis-professional",
  "version": "2.0.0-beta",
  "description": "ARTemis Professional — Digital painting application with advanced brush engine, vector tools, and AI features. Works standalone in browser or as Electron desktop app.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:browser": "echo 'Open src/index.html directly in your browser' && exit 0",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "test": "echo \"Tests will be added\" && exit 0"
  },
  "keywords": [
    "digital-painting",
    "art",
    "graphics",
    "drawing",
    "painting",
    "browser-app",
    "standalone",
    "creative-tools",
    "canvas",
    "webgl",
    "pwa"
  ],
  "author": "BulletDrop Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mllinman/ARTemis-Professional"
  },
  "homepage": "https://github.com/mllinman/ARTemis-Professional#readme",
  "bugs": {
    "url": "https://github.com/mllinman/ARTemis-Professional/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "electron": "^34.0.0"
  },
  "devDependencies": {
    "canvas": "^3.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  },
  "dependencies": {
    "ag-psd": "^28.4.1",
    "utif": "^3.1.0"
  }
}
